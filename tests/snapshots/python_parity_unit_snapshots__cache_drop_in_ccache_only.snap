[Service]
Group=ghars-cache-build
Environment=CCACHE_DIR=%C/ghars/pools/build/ccache
Environment=CCACHE_MAXSIZE=200G
ExecStart=/usr/bin/sleep infinity
ReadWritePaths=%C/ghars/pools/build
